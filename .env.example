# Copy this file to `.env.local` and fill in the real values, then restart `npm run dev`.
# `.env.local` is gitignored; this file is committed as documentation.

# --- Backend ---
# Base URL of the FastAPI server (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# --- Firebase Web app ---
# Firebase console > Project settings > General > "Your apps" > Web app >
#   "SDK setup and configuration" > Config.
# The project is "importease-63e99" (matches the backend service-account key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=importease-63e99.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=importease-63e99
VITE_FIREBASE_STORAGE_BUCKET=importease-63e99.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
